# R6T5 Drive 环境变量示例
# 用法：cp .env.example .env，再按需填写；.env 不会进入版本库（见 .gitignore）。

# 监听端口（容器内端口；compose 已将主机 8080 映射到该端口）
PORT=8080

# SQLite 元数据库路径（相对数据目录或绝对路径）
DB_PATH=data/r6t5.db

# 文件物理存储根目录；用户根目录为 <STORAGE_ROOT>/<Email>/...
STORAGE_ROOT=data/volume

# 会话签名密钥。生成方式：openssl rand -hex 32
# 生产环境务必替换为下面命令输出的随机串，不要留空。
SESSION_SECRET=

# 管理员密码。留空则首次启动自动生成随机密码，并打印到服务端日志（启动时可见一次）。
# 若填写，则以此处配置为准；生产环境建议留空、从日志取一次后在后台修改。
ADMIN_PASSWORD=

# 开发自测登录开关：默认关闭（0）。仅本地联调试用，生产必须保持 0。
# 置 1 后 /api/auth/dev-login 可绕过 Supabase 直接登录，有越权风险。
DEV_AUTH=0

# 时区
TZ=Asia/Shanghai

# 回收站保留天数：软删文件超过该天数后由清理任务永久删除
TRASH_RETENTION_DAYS=30

# ────────────────────────────────────────────────────────────────────────
# 说明：Supabase 的 URL / anon key / service key 不写在本文件里。
# 这些凭据由管理员在后台（/admin/settings 对应的 Supabase 配置页）填写，
# 只保存在服务端 SQLite 中，永不进入环境变量、永不下发前端；
# service key 仅用于服务端管理员接口（建号、拉取用户映射）。
# 因此本文件不提供 SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY 条目。
# ────────────────────────────────────────────────────────────────────────
